{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sentinel-signer",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel-db",
      "database_id": "f3fa44b2-2b49-4af1-8687-2346cb336b22"
    },
    {
      "binding": "DB2",
      "database_name": "db2",
      "database_id": "80a08a93-4353-4dba-914d-a436afd040c9",
      "migrations_dir": "../migrations-signer"
    }
  ]
}