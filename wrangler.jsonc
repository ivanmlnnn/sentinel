{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/*"] },
  "services": [
    { "binding": "SIGNER_SERVICE", "service": "sentinel-signer" }
  ],
  "ratelimits": [
    { "name": "API_RATE_LIMITER", "namespace_id": "2026111001", "simple": { "limit": 60, "period": 60 } },
    { "name": "INVESTIGATION_RATE_LIMITER", "namespace_id": "2026111002", "simple": { "limit": 12, "period": 60 } },
    { "name": "AGENT_RATE_LIMITER", "namespace_id": "2026111003", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "sentinel-db", "database_id": "f3fa44b2-2b49-4af1-8687-2346cb336b22", "migrations_dir": "migrations-d1" }
  ]
}
