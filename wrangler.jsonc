{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel",
  "main": "src/index.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "f3fa44b2-2b49-4af1-8687-2346cb336b22"
    }
  ]
}
